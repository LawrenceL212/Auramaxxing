# Blender source files stay out of the repo - large binaries the runtime never
# consumes. Only exported assets under 3d/exports/ ship.
*.blend
*.blend1

# Raw pre-optimisation GLB intermediates. Only the meshopt-compressed runtime
# asset is committed; the raw export is reproducible from the build script.
exports/*-raw.glb

# Rejected prototype: procedural metaball mannequin (v1-v4). Superseded by the
# MPFB2 pipeline in build_hunter_mpfb.py. Kept locally as a record only.
source/hunter/build_hunter.py

# Intermediate triangle/UV dumps - regenerated by bake_uv_regions.py
exports/_regions-*.npz

# Python bytecode
__pycache__/
*.pyc
